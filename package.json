{
  "name": "kocpy",
  "version": "0.1.36",
  "description": "Kocpy 专业素材工作台 · 多目的地备份、独立校验与项目归档",
  "main": "out/main/index.js",
  "productName": "Kocpy",
  "author": "Kocpy",
  "license": "MIT",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "start": "npm run dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:report-pdf": "mkdir -p work && esbuild scripts/verify-report-pdf.ts --bundle --platform=node --format=cjs --external:electron --outfile=work/verify-report-pdf.cjs && electron work/verify-report-pdf.cjs",
    "verify:source": "node scripts/verify-source-tree.mjs",
    "verify:media": "node scripts/verify-media-runtime.mjs",
    "verify:release": "npm run verify:source && npm run verify:media",
    "prepack": "npm run verify:release",
    "predist": "npm run verify:release",
    "prepack:arm64": "npm run verify:release",
    "prepack:x64": "npm run verify:release",
    "predist:arm64": "npm run verify:release",
    "predist:x64": "npm run verify:release",
    "pack": "npm run build && node scripts/build-macos-candidate.cjs --arm64 --dir",
    "dist": "npm run build && node scripts/build-macos-candidate.cjs --arm64 --x64",
    "pack:arm64": "npm run build && node scripts/build-macos-candidate.cjs --arm64 --dir",
    "pack:x64": "npm run build && node scripts/build-macos-candidate.cjs --x64 --dir",
    "dist:arm64": "npm run build && node scripts/build-macos-candidate.cjs --arm64",
    "dist:x64": "npm run build && node scripts/build-macos-candidate.cjs --x64",
    "test:hardware": "node scripts/run-hardware-acceptance.mjs",
    "test:large": "KOCPY_LARGE_TEST=100000 vitest run tests/catalog-stress.integration.test.ts",
    "test:million": "KOCPY_LARGE_TEST=1000000 vitest run tests/catalog-stress.integration.test.ts",
    "test:workspace-large": "KOCPY_WORKSPACE_LARGE_TEST=100000 vitest run tests/workspace-stress.integration.test.ts"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "beforePack": "scripts/before-pack.cjs",
    "afterPack": "scripts/after-pack.cjs",
    "appId": "com.kocpy.studio",
    "productName": "Kocpy",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": true,
      "target": [
        "dmg"
      ],
      "artifactName": "Kocpy-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg-darwin-*",
          "build-info-*.json",
          "NOTICE.md",
          "FFmpeg-*",
          "x264-COPYING",
          "sources/**/*"
        ]
      }
    ]
  }
}

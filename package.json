{
  "name": "kocpy",
  "version": "0.0.1",
  "description": "Kocpy 专业素材工作台 · 多目的地备份、独立校验与项目归档",
  "main": "out/main/index.js",
  "productName": "Kocpy",
  "author": "Kocpy",
  "license": "MIT",
  "scripts": {
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "start": "npm run dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --mac --arm64 --dir",
    "dist": "npm run build && electron-builder --mac --arm64 --x64",
    "pack:arm64": "npm run build && electron-builder --mac --arm64 --dir",
    "pack:x64": "npm run build && electron-builder --mac --x64 --dir",
    "dist:arm64": "npm run build && electron-builder --mac --arm64",
    "dist:x64": "npm run build && electron-builder --mac --x64"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "lucide-react": "^0.475.0",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.kocpy.studio",
    "productName": "Kocpy",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        "dmg"
      ],
      "artifactName": "Kocpy-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "resources/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg-darwin-*",
          "LICENSE-*"
        ]
      }
    ]
  }
}
